# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.venv/
venv/
build/
dist/

# 编辑器
.vscode/
.idea/

# 日志与临时文件
*.log
*.tmp

# 运行时数据（轨迹等）。放仓库里是为了找得到，但**绝不能被跟踪** ——
# 里面有对话原文和工具输出。这条是保险，别删。
var/

# 密钥与运行时配置：真实文件在 ~/.config/{chat,fortrix}/ 与 /usr/local/etc/cpolar/，
# 仓库里只允许 *.env.example 模板。这条是保险，别删。
*.env
*.env.*
!*.env.example

