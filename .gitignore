# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.venv/
venv/
build/
dist/

# 编辑器
.vscode/
.idea/

# 日志与临时文件
*.log
*.tmp

# 密钥与运行时配置：真实文件在 ~/.config/{chat,fortrix}/ 与 /usr/local/etc/cpolar/，
# 仓库里只允许 *.env.example 模板。这条是保险，别删。
*.env
*.env.*
!*.env.example

# UI 改造前的本地备份：留在磁盘上备查，但不进版本库
# （git 已经有历史了，这类目录进仓库只会让 diff 变脏）
static-backup-*/
