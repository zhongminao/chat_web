# cpolar 隧道配置模板 —— 只有结构，值全部留空
#
# 真实文件：/usr/local/etc/cpolar/cpolar.yml（**保持在原地，不要移动**）
# 读取方　：cpolar.service 的 -config=/usr/local/etc/cpolar/cpolar.yml
#
# ⚠️ 真实文件含 authtoken（cpolar 账号凭证）和各隧道的 Basic Auth 密码。
#    **永远不要**把它复制进仓库 —— 泄露 authtoken 等于交出所有隧道的公网暴露面。
#    本模板只用来记录结构，换机器时照此重建。
#
# 注意：cpolar.service 是 user 服务，只点名启动 fortrix8000 与 chat8200
# （408ssh 的远程端口被同账号其他客户端占用，start-all 会整体失败）。

authtoken: ""                # cpolar 账号凭证

tunnels:

  408ssh:                    # tcp 22；当前未启用，配置原样保留
    proto: tcp
    addr: "22"
    region: cn_vip
    remote_addr: ""

  fortrix8000:
    proto: http
    addr: "8000"
    region: cn_vip
    redirect_https: true
    auth: ""                 # 公网 Basic Auth，格式 "用户:密码"

  chat8200:
    proto: http
    addr: "8200"
    region: cn_vip
    redirect_https: true
    auth: ""                 # 公网 Basic Auth，格式 "用户:密码" —— chat 的公网密码
