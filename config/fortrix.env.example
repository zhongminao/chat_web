# fortrix 的运行时配置模板
#
# 真实文件：~/.config/fortrix/fortrix.env
# 读取方　：fortrix.service 的 EnvironmentFile=%h/.config/fortrix/fortrix.env
#
# 真实值（用户名/密码/SECRET_KEY）只存在于上面那个文件里，不要写进仓库。
# 这里只记录**有哪些变量**，方便换机器时照此重建。

FORTRIX_BASIC_AUTH_ENABLED=
FORTRIX_BASIC_AUTH_USERNAME=
FORTRIX_BASIC_AUTH_PASSWORD=
FORTRIX_BASIC_AUTH_REALM=
FORTRIX_DEBUG=
FORTRIX_SECRET_KEY=
